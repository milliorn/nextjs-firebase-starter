# Copy this file to .env.local and fill in your Firebase project's values.
# Find them in the Firebase Console: Project settings > General > Your apps > SDK setup and configuration.
# These are client-side config values, not secrets. Firebase ships them to every visitor's browser by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
